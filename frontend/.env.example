# ── FloodWatch Core (Supabase Realtime & FastAPI Backend) ────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
NEXT_PUBLIC_API_URL=http://localhost:8000

# ── App Branding ─────────────────────────────────────────────
NEXT_PUBLIC_APP_NAME=FloodWatch

# ── Better Auth (Optional) ───────────────────────────────────
BETTER_AUTH_SECRET=                             # Generate: openssl rand -hex 32
BETTER_AUTH_URL=http://localhost:3000           # App base URL
NEXT_PUBLIC_BETTER_AUTH_URL=http://localhost:3000

# ── MongoDB (Optional / Better Auth) ─────────────────────────
MONGODB_DIRECT_URI=                            # e.g. mongodb+srv://user:pass@cluster.mongodb.net/dbname

# ── OAuth Providers (Optional) ───────────────────────────────
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# ── Email (SMTP) ─────────────────────────────────────────────
EMAIL_USER=
EMAIL_PASS=

# ── ImageKit (File uploads) ──────────────────────────────────
NEXT_PUBLIC_IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
NEXT_PUBLIC_IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_imagekit_id
