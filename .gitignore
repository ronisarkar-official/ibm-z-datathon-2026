# ==============================================================================
# FloodWatch Monorepo Root .gitignore
# Covers Python backend (FastAPI, XGBoost), Next.js 16 frontend, IDEs, and OS
# ==============================================================================

# ------------------------------------------------------------------------------
# Environment Variables & Secrets (CRITICAL: Do NOT commit secrets)
# ------------------------------------------------------------------------------
.env
.env.*
*.env
*.env.*
!.env.example
!*.env.example
!backend/.env.example
!frontend/.env.example

# Specific app local env files
.env.local
.env.development.local
.env.test.local
.env.production.local
backend/.env
frontend/.env.local

# ------------------------------------------------------------------------------
# Python & Backend Artifacts
# ------------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual Environments
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/
backend/.venv/
backend/venv/
backend/env/

# Python Testing & Type Checking
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.mypy_cache/
.ruff_cache/
.dmypy.json
dmypy.json
.hypothesis/

# ------------------------------------------------------------------------------
# Node.js & Frontend Artifacts (Next.js 16)
# ------------------------------------------------------------------------------
node_modules/
*/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
lerna-debug.log*

# Next.js build output
.next/
*/.next/
out/
*/out/

# Production builds
frontend/build/
frontend/dist/

# Turbo cache
.turbo/
*/.turbo/

# TypeScript build info & caches
*.tsbuildinfo
.eslintcache
next-env.d.ts

# ------------------------------------------------------------------------------
# Operating System & Filesystem Junk
# ------------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Thumbs.db:encryptable
[Dd]esktop.ini
$RECYCLE.BIN/

# ------------------------------------------------------------------------------
# IDEs, Editors & Developer Tools
# ------------------------------------------------------------------------------
.idea/
.vscode/
*.swp
*.swo
*~
*.sublime-workspace
*.sublime-project
.project
.settings/

# Agent session logs & duplicate cache
.opencode/
*/.opencode/
graphify-out/
*/graphify-out/
/data/skills/

# ------------------------------------------------------------------------------
# Logs & Temporary Files
# ------------------------------------------------------------------------------
logs/
*.log
*.tmp
*.temp
*.pem
*.key
*.cert
*.crt
